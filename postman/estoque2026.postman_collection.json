                  "});",
                  "pm.test('Retorna lista de bebidas com categoria', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "    if (data.length > 0) {",
                  "        pm.expect(data[0]).to.have.property('categoriaNome');",
                  "        pm.expect(data[0].categoriaNome).to.not.be.null;",
                  "    }",
